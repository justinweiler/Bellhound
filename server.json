{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.justinweiler/bellhound",
  "title": "Bellhound",
  "description": "Let the originating AI agent make phone calls without handing reasoning to a proxy model.",
  "version": "0.6.6",
  "websiteUrl": "https://github.com/justinweiler/Bellhound",
  "repository": {
    "url": "https://github.com/justinweiler/Bellhound",
    "source": "github",
    "id": "1413833452"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/justinweiler/Bellhound/v0.6.6/assets/bellhound-plugin-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "cargo",
      "registryBaseUrl": "https://crates.io",
      "identifier": "bellhound",
      "version": "0.6.6",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--config",
          "value": "{config_path}",
          "variables": {
            "config_path": {
              "description": "Absolute path to the operator's Bellhound TOML configuration.",
              "isRequired": true,
              "isSecret": false,
              "format": "filepath",
              "placeholder": "/absolute/path/to/bellhound.toml"
            }
          }
        },
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
